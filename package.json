{
  "name": "@uplo/monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Justas Palumickas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpalumickas/uplo.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "packages:publish": "pnpm publish -r --filter @uplo/*",
    "version:patch": "lerna version patch --force-publish",
    "version:minor": "lerna version minor --force-publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "lerna": "^9.0.7",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620"
}
