{
  "name": "@uplo/monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Justas Palumickas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpalumickas/uplo.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "packages:publish": "pnpm publish -r --filter @uplo/*",
    "version:patch": "lerna version patch --force-publish",
    "version:minor": "lerna version minor --force-publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "lerna": "^9.0.7",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d"
}
