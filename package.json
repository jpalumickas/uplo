{
  "name": "@uplo/monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Justas Palumickas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpalumickas/uplo.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "packages:publish": "pnpm publish -r --filter @uplo/*",
    "version:patch": "lerna version patch --force-publish",
    "version:minor": "lerna version minor --force-publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "lerna": "^10.0.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
