{
  "name": "@uplo/monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Justas Palumickas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpalumickas/uplo.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "packages:publish": "pnpm publish -r --filter @uplo/*",
    "version:patch": "lerna version patch --force-publish",
    "version:minor": "lerna version minor --force-publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "lerna": "^10.0.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
