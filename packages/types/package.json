{
  "name": "@uplo/types",
  "version": "0.23.0",
  "homepage": "https://uplo.js.org",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpalumickas/uplo.git",
    "directory": "packages/types"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@uplo/utils": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^25.9.1"
  },
  "engines": {
    "node": ">=20"
  }
}
