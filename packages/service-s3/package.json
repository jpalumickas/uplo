{
  "name": "@uplo/service-s3",
  "version": "0.24.0",
  "keywords": [
    "amazon",
    "aws",
    "bucket",
    "digital ocean",
    "digitalocean",
    "minio",
    "s3",
    "upload",
    "uploads"
  ],
  "homepage": "https://uplo.js.org",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpalumickas/uplo.git",
    "directory": "packages/service-s3"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/lib-storage": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@uplo/service-base": "workspace:^",
    "@uplo/types": "workspace:^",
    "@uplo/utils": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@uplo/server": "workspace:^"
  },
  "peerDependencies": {
    "@uplo/server": "workspace:^"
  },
  "engines": {
    "node": ">=20"
  }
}
