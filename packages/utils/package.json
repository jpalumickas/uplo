{
  "name": "@uplo/utils",
  "version": "0.23.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": {
    "crypto": false
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "worker": "./dist/browser.js",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpalumickas/uplo.git",
    "directory": "packages/utils"
  },
  "homepage": "https://uplo.js.org",
  "scripts": {
    "build": "rimraf dist && pnpm build:node && pnpm build:browser",
    "build:node": "tsup src/index.ts --format cjs,esm --dts",
    "build:browser": "tsup --entry.browser src/browser/index.ts --format esm",
    "test": "vitest run",
    "test:dev": "vitest dev"
  },
  "devDependencies": {
    "@tinyhttp/content-disposition": "~2.2.2",
    "@types/node": "^25.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
