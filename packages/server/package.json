{
  "name": "@uplo/server",
  "version": "0.23.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./route-handler": {
      "import": {
        "types": "./dist/route-handler/index.d.mts",
        "default": "./dist/route-handler/index.mjs"
      },
      "require": {
        "types": "./dist/route-handler/index.d.cts",
        "default": "./dist/route-handler/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpalumickas/uplo.git",
    "directory": "packages/server"
  },
  "homepage": "https://uplo.js.org",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:dev": "vitest dev"
  },
  "dependencies": {
    "@uplo/types": "workspace:^",
    "@uplo/utils": "workspace:^",
    "camelcase": "^9.0.0",
    "hono": "^4.12.21",
    "jose": "^5.10.0",
    "mime": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mime": "^4.0.0",
    "@types/node": "^25.9.0"
  },
  "keywords": [
    "gcs",
    "s3",
    "bucket",
    "upload",
    "uploads",
    "direct upload"
  ]
}
