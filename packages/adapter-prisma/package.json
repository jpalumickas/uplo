{
  "name": "@uplo/adapter-prisma",
  "version": "0.23.0",
  "keywords": [
    "mysql",
    "postgres",
    "postgresql",
    "prisma",
    "upload",
    "uploads"
  ],
  "homepage": "https://uplo.js.org",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpalumickas/uplo.git",
    "directory": "packages/adapter-prisma"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "generate": "prisma generate"
  },
  "dependencies": {
    "@uplo/types": "workspace:^"
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "@uplo/server": "workspace:^",
    "dataloader": "^2.2.3",
    "prisma": "^7.8.0"
  },
  "peerDependencies": {
    "@prisma/client": ">=7.0.0",
    "@uplo/server": "workspace:^",
    "dataloader": ">=2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
