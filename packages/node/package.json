{
  "name": "@uplo/node",
  "version": "0.23.0",
  "keywords": [
    "bucket",
    "direct upload",
    "express",
    "fastify",
    "gcs",
    "s3",
    "upload",
    "uploads"
  ],
  "homepage": "https://uplo.js.org",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpalumickas/uplo.git",
    "directory": "packages/node"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:dev": "vitest dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@uplo/server": "workspace:^",
    "mime": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20"
  }
}
