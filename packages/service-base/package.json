{
  "name": "@uplo/service-base",
  "version": "0.23.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpalumickas/uplo.git",
    "directory": "packages/service-base"
  },
  "homepage": "https://uplo.js.org",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts"
  },
  "dependencies": {
    "@uplo/types": "workspace:^"
  },
  "engines": {
    "node": ">=20"
  }
