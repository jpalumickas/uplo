{
  "name": "@uplo/react-native",
  "version": "0.23.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpalumickas/uplo.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://uplo.js.org",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts"
  },
  "dependencies": {
    "mime": "^3.0.0"
  },
  "peerDependencies": {
    "expo-file-system": ">= 16",
    "react": ">= 16.4"
  },
  "devDependencies": {
    "@types/mime": "^3.0.4",
    "@types/react": "^19.2.7",
    "expo-file-system": "^56.0.4",
    "react": "^19.2.6"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "react",
    "react-native",
    "upload",
    "uploads"
  ]
}
