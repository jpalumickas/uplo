{
  "name": "@uplo/react",
  "version": "0.23.0",
  "keywords": [
    "react",
    "upload",
    "uploads"
  ],
  "homepage": "https://uplo.js.org",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpalumickas/uplo.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:dev": "vitest dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "mime": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "react": ">= 16.4"
  },
  "engines": {
    "node": ">=20"
  }
}
